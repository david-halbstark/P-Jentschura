{% assign char_lt = '%3C' | url_decode %}
{% assign char_gt = '%3E' | url_decode %}
{% assign char_slash = '%2F' | url_decode %}

{% assign button_label = label %}
{% assign button_mode = mode | default: 'link' %}
{% assign button_url = url %}
{% assign button_action = action %}

{% assign button_variant = variant | default: 'solid' %}
{% assign button_bg = color %}
{% assign button_text_size = text_size %}
{% assign button_padding = padding %}
{% assign button_underline = underline | default: false %}
{% assign button_pill_tag_inner = pill_tag_inner %}

{% assign button_icon = icon | default: 'none' %}
{% assign button_icon_position = icon_position | default: 'after' %}
{% assign button_icon_animation = icon_animation | default: 'none' %}

{% assign button_trigger = trigger %}
{% assign button_custom_class = custom_class %}

{% assign button_custom_attribute_name = custom_attribute_name %}
{% assign button_custom_attribute_value = custom_attribute_value %}

{% assign button_wrap_classes = 'button_wrap' %}
{% assign button_text_classes = 'button_text' %}
{% assign button_tag_classes = 'button_tag' %}
{% assign button_text_style_class = '' %}

{% if button_variant != blank %}
  {% assign button_variant_class = button_variant | replace: '_', '-' %}
  {% assign button_wrap_classes = button_wrap_classes | append: ' is-variant-' | append: button_variant_class %}
{% endif %}

{% if button_bg != blank %}
  {% assign button_bg_class = button_bg | replace: '_', '-' %}
  {% assign button_wrap_classes = button_wrap_classes | append: ' is-bg-' | append: button_bg_class %}
{% endif %}

{% if button_padding != blank %}
  {% assign button_padding_class = button_padding | replace: '_', '-' %}
  {% assign button_wrap_classes = button_wrap_classes | append: ' is-padding-' | append: button_padding_class %}
{% endif %}

{% if button_underline %}
  {% assign button_wrap_classes = button_wrap_classes | append: ' has-underline' %}
{% endif %}

{% if button_icon != blank and button_icon != 'none' %}
  {% assign button_icon_position_class = button_icon_position | replace: '_', '-' %}
  {% assign button_wrap_classes = button_wrap_classes | append: ' has-icon' %}
  {% assign button_wrap_classes = button_wrap_classes | append: ' has-icon-' | append: button_icon_position_class %}
{% endif %}

{% if button_icon_animation != blank and button_icon_animation != 'none' %}
  {% assign button_icon_animation_class = button_icon_animation | replace: '_', '-' %}
  {% assign button_wrap_classes = button_wrap_classes
    | append: ' has-icon-animation-'
    | append: button_icon_animation_class
  %}
{% endif %}

{% if button_custom_class != blank %}
  {% assign button_custom_class_clean = button_custom_class | replace: '_', '-' %}
  {% assign button_wrap_classes = button_wrap_classes | append: ' ' | append: button_custom_class_clean %}
{% endif %}

{% if button_variant == 'transparent' %}
  {% assign button_text_style_class = 'u-text-link-large' %}
{% elsif button_text_size != blank %}
  {% assign button_text_style_class = button_text_size %}
{% endif %}

{% if button_text_style_class != blank %}
  {% assign button_text_classes = button_text_classes | append: ' ' | append: button_text_style_class %}
  {% assign button_tag_classes = button_tag_classes | append: ' ' | append: button_text_style_class %}
{% endif %}

{% assign button_modal_key = '' %}
{% assign button_data_action = button_action %}
{% if button_mode == 'action' %}
  {% assign button_action_prefix = button_action | slice: 0, 11 %}
  {% if button_action_prefix == 'open_modal_' %}
    {% assign button_modal_key = button_action | remove_first: 'open_modal_' %}
  {% else %}
    {% case button_action %}
      {% when 'copy_link' %}
        {% assign button_data_action = 'copy_link' %}
    {% endcase %}
  {% endif %}
{% endif %}

{% assign button_action_attr = '' %}
{% if button_mode == 'action' %}
  {% if button_modal_key != blank %}
    {% assign button_action_attr = 'data-modal-open="' | append: button_modal_key | append: '"' %}
  {% elsif button_data_action != blank %}
    {% assign button_action_attr = 'data-action="' | append: button_data_action | append: '"' %}
  {% endif %}
{% endif %}

{% assign button_custom_attr = '' %}
{% if button_custom_attribute_name != blank and button_custom_attribute_value != blank %}
  {% assign button_custom_attr = button_custom_attribute_name
    | append: '="'
    | append: button_custom_attribute_value
    | append: '"'
  %}
{% elsif button_custom_attribute_name != blank %}
  {% assign button_custom_attr = button_custom_attribute_name %}
{% endif %}

{% assign show_button = false %}
{% assign show_clickable = false %}
{% if button_label != blank %}
  {% if button_mode == 'link' and button_url != blank %}
    {% assign show_button = true %}
    {% assign show_clickable = true %}
  {% elsif button_mode == 'action' and button_modal_key != blank %}
    {% assign show_button = true %}
    {% assign show_clickable = true %}
  {% elsif button_mode == 'action' and button_data_action != blank %}
    {% assign show_button = true %}
    {% assign show_clickable = true %}
  {% elsif button_mode == 'submit' %}
    {% assign show_button = true %}
    {% assign show_clickable = true %}
  {% elsif button_mode == 'visual' %}
    {% assign show_button = true %}
  {% endif %}
{% endif %}

{% assign button_aria_label = button_label | strip_html | escape %}

{% assign button_clickable_inner = '' %}
{% if button_mode == 'link' %}
  {% capture button_clickable_inner %}{{ char_lt }}a aria-label="{{ button_aria_label }}" href="{{ button_url }}" class="clickable_link"{{ char_gt }}{{ char_lt }}{{ char_slash }}a{{ char_gt }}{% endcapture %}
{% elsif button_mode == 'action' %}
  {% capture button_clickable_inner %}{{ char_lt }}button type="button" aria-label="{{ button_aria_label }}" class="clickable_link" {{ button_action_attr }}{{ char_gt }}{{ char_lt }}{{ char_slash }}button{{ char_gt }}{% endcapture %}
{% elsif button_mode == 'submit' %}
  {% capture button_clickable_inner %}{{ char_lt }}button type="submit" aria-label="{{ button_aria_label }}" class="clickable_link"{{ char_gt }}{{ char_lt }}{{ char_slash }}button{{ char_gt }}{% endcapture %}
{% endif %}

{% if show_button %}
  {{ char_lt }}div data-trigger="{{ button_trigger }}" class="{{ button_wrap_classes }}" {{ button_custom_attr -}}
  {{- char_gt }}
  {% if show_clickable %}
    {{ char_lt }}div class="clickable_wrap u-cover-absolute"{{ char_gt -}}
    {{- button_clickable_inner -}}
    {{- char_lt -}}
    {{- char_slash }}div{{ char_gt }}
  {% endif %}
  {{ char_lt }}div aria-hidden="true" class="button_element"{{ char_gt }}
  {% if button_icon != blank and button_icon != 'none' and button_icon_position == 'before' %}
    {{ char_lt }}div class="button_icon"{{ char_gt -}}
    {%- render 'icon', icon: button_icon -%}
    {{- char_lt -}}
    {{- char_slash }}div{{ char_gt }}
  {% endif %}
  {% if button_variant == 'pill' and button_pill_tag_inner != blank %}
    {{ char_lt }}div class="button_text_wrap"{{ char_gt }}
    {{ char_lt }}div class="{{ button_text_classes }}"{{ char_gt -}}
    {{- button_label -}}
    {{- char_lt -}}
    {{- char_slash }}div{{ char_gt }}
    {{ char_lt }}span class="{{ button_tag_classes }}"{{ char_gt -}}
    {{- button_pill_tag_inner -}}
    {{- char_lt -}}
    {{- char_slash }}span{{ char_gt }}
    {{ char_lt -}}
    {{- char_slash }}div{{ char_gt }}
  {% else %}
    {{ char_lt }}div class="{{ button_text_classes }}"{{ char_gt -}}
    {{- button_label -}}
    {{- char_lt -}}
    {{- char_slash }}div{{ char_gt }}
  {% endif %}
  {% if button_icon != blank and button_icon != 'none' and button_icon_position == 'after' %}
    {{ char_lt }}div class="button_icon"{{ char_gt -}}
    {%- render 'icon', icon: button_icon -%}
    {{- char_lt -}}
    {{- char_slash }}div{{ char_gt }}
  {% endif %}
  {{ char_lt -}}
  {{- char_slash }}div{{ char_gt }}
  {{ char_lt -}}
  {{- char_slash }}div{{ char_gt }}
{% endif %}
