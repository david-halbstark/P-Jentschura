        <div class="u-embed-js w-embed w-script">
          <script>
  (function () {
    'use strict';
    var lastOpener = null; // Button, der das Modal ge&ouml;ffnet hat
    function openModal(key, opener) {
      var d = document.querySelector('dialog[data-modal="' + CSS.escape(key) + '"]');
      if (d && d.showModal) {
        lastOpener = opener || null;
        d.classList.remove('is-closing');
        d.showModal();
        document.documentElement.style.overflow = 'hidden';
      }
    }
    // Animiertes, Safari-sicheres Schlie&szlig;en: erst rausslide, DANN close().
    function closeModal(d) {
      if (!d || !d.open || d.classList.contains('is-closing')) return;
      d.classList.add('is-closing');
      var finished = false;
      var done = function () {
        if (finished) return;
        finished = true;
        d.removeEventListener('transitionend', onEnd);
        d.classList.remove('is-closing');
        d.close(); // native Fokus-R&uuml;ckgabe an den Opener
        document.documentElement.style.overflow = '';
        // Sicherheitsnetz: falls der Fokus nicht am Button landet, nachhelfen
        if (lastOpener && document.activeElement !== lastOpener) {
          lastOpener.focus({ preventScroll: true });
        }
        lastOpener = null;
      };
      var onEnd = function (e) {
        if (e.target === d) done(); // nur die Transition des Dialogs selbst
      };
      d.addEventListener('transitionend', onEnd);
      // Fallback, falls transitionend nicht feuert (etwas mehr als --dur-out)
      setTimeout(done, 260);
    }
    document.addEventListener('click', function (e) {
      var opener = e.target.closest('[data-modal-open]');
      if (opener) {
        e.preventDefault();
        openModal(opener.getAttribute('data-modal-open'), opener);
        return;
      }
      var closer = e.target.closest('[data-modal-close]');
      if (closer) {
        closeModal(closer.closest('dialog[data-modal]'));
        return;
      }
      if (e.target.matches('dialog[data-modal]')) closeModal(e.target);
    });
    // ESC: natives Sofort-Schlie&szlig;en abfangen und stattdessen animiert schlie&szlig;en.
    // 'cancel' bubbelt nicht -> Capture-Phase.
    document.addEventListener(
      'cancel',
      function (e) {
        if (e.target.matches && e.target.matches('dialog[data-modal]')) {
          e.preventDefault();
          closeModal(e.target);
        }
      },
      true,
    );
  })();
</script>
