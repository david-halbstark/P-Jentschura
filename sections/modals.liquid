<div class="u-embed-css w-embed">
          <style>
  /* offen */
  .modal_wrap[open] {
    transform: translateX(0);
  }
  /* Startwert beim &Ouml;ffnen -> Slide-in */
  @starting-style {
    .modal_wrap[open] {
      transform: translateX(100%);
    }
  }
  /* Schlie&szlig;en: Dialog ist noch [open], slidet raus, dann close() im JS.
       K&uuml;rzere Dauer -> Fokus kommt schneller zum Button zur&uuml;ck. */
  .modal_wrap.is-closing {
    transition: transform var(--dur-out) var(--ease);
  }
  .modal_wrap[open].is-closing {
    transform: translateX(100%);
  }
  .modal_wrap::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .modal_wrap[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    .modal_wrap[open]::backdrop {
      opacity: 0;
    }
  }
  .modal_wrap.is-closing::backdrop {
    transition: opacity var(--dur-out) var(--ease);
  }
  .modal_wrap[open].is-closing::backdrop {
    opacity: 0;
  }
  .modal_wrap.is-full {
    transform: none;
  }
  /* ----------------- Reduced motion: nur Fade ----------------- */
  @media (prefers-reduced-motion: reduce) {
    .modal_wrap,
    .modal_wrap[open],
    .modal_wrap[open].is-closing {
      transform: none;
    }
    .modal_wrap {
      opacity: 0;
      transition: opacity var(--dur) ease;
    }
    .modal_wrap[open] {
      opacity: 1;
    }
    .modal_wrap[open].is-closing {
      opacity: 0;
    }
    @starting-style {
      .modal_wrap[open] {
        opacity: 0;
      }
    }
  }
</style>
        </div>
        
