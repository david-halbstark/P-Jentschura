        <div class="newsletter_background">
          {% render 'image', width_mobile: 1200, image: section.settings.image, loading: 'lazy', image_mobile: section.settings.image_mobile, width: 2000, breakpoint: '41.9375em', object_fit: 'cover' %}
        </div>
        <div class="newsletter_contain u-container" {% if section.settings.section_id != blank %}id='{{ section.settings.section_id | handleize }}'{% endif %}>
          <div class="newsletter_layout">
            <div class="newsletter_form_block w-form">
              <form id="email-form" name="email-form" data-name="Email Form" method="get" class="newsletter_form" data-wf-page-id="6a28298c06ea8567096aa065" data-wf-element-id="df392e1f-adb4-56c5-1565-3028b85261b3">
                <div class="newsletter_top u-margin-trim">
                  {% render 'eyebrow', variant: 'u-text-eyebrow-base', eyebrow: section.settings.eyebrow %}
                  {% render 'heading', custom_class: 'u-margin-bottom-0 u-min-width-auto', heading: section.settings.heading, tag: section.settings.heading_tag, variant: 'u-text-h2-primary', max_width: section.settings.heading_max_width, tidy_text: section.settings.heading_tidy_text %}
                </div>
                <div class="newsletter_bot">
                  <div class="newsletter_bot_inner u-box-shadow"><label class="newsletter_label_wrap"><span for="newsletter-email" class="newsletter_label u-sr-only"></span><input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="{{ settings.newsletter_form_placeholder }}" method="post" action="{{ settings.newsletter_form_action }}" class="newsletter_input"></label>
                    <div class="newsletter_button_wrap u-button-wrapper">
                      {% render 'button', action: section.settings.button_1_action, padding: 'base', text_size: 'u-text-link-large', label: section.settings.button_1_label, trigger: 'hover focus', custom_attribute_value: , custom_attribute_name: , mode: 'solid', color: 'red', variant: 'base' %}
                      
                    </div>
                  </div>
                  <div class="newsletter_bot_paragraph">
                    {% render 'paragraph', tidy_text: section.settings.paragraph_tidy_text, custom_class: 'u-margin-bottom-0', paragraph: section.settings.paragraph, variant: 'u-text-body-small', max_width: section.settings.paragraph_max_width %}
                  </div>
                </div>
              </form>
              <div class="w-form-done">
                <div>Thank you! Your submission has been received!</div>
              </div>
              <div class="w-form-fail">
                <div>Oops! Something went wrong while submitting the form.</div>
              </div>
            </div>
          </div>
