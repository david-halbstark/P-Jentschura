        <div class="newsletter_background">
          {% render 'image', width_mobile: 1200, image: section.settings.image, loading: 'lazy', image_mobile: section.settings.image_mobile, width: 2000, breakpoint: '41.9375em', object_fit: 'cover' %}
        </div>
        <div class="newsletter_contain u-container" {% if section.settings.section_id != blank %}id='{{ section.settings.section_id | handleize }}'{% endif %}>
          <div class="newsletter_layout" {% if section.settings.variant  == 'large' %}data-variant='large'{% endif %}>
            <div class="newsletter_form_block w-form">
              <form id="wf-form-Newsletter" name="wf-form-Newsletter" data-name="Newsletter" method="get" class="newsletter_form" data-wf-page-id="6a28298c06ea8567096aa065" data-wf-element-id="df392e1f-adb4-56c5-1565-3028b85261b3">
                <div class="newsletter_top u-margin-trim">
                  {% render 'eyebrow', variant: 'u-text-eyebrow-base', eyebrow: eyebrow %}
                  {% render 'heading', custom_class: 'u-margin-bottom-0 u-min-width-auto', heading: heading, tag: section.settings.heading_tag, variant: 'u-text-h2-primary', max_width: heading_max_width, tidy_text: heading_tidy_text %}
                </div>
                <div class="newsletter_bot">
                  <div class="newsletter_bot_inner u-box-shadow"><label class="newsletter_label_wrap"><span for="email" class="newsletter_label u-sr-only"></span><input id="email" name="email" type="email" autocomplete="email" placeholder="{{ settings.newsletter_placeholder }}" method="post" action="newsletter_submit" class="newsletter_input"></label>
                    <div class="newsletter_button_wrap u-button-wrapper">
                      {% render 'button', action: 'newsletter_send', padding: 'base', text_size: 'u-text-link-large', label: settings.newsletter_button_label, trigger: 'hover focus', mode: 'solid', color: 'red', variant: 'base' %}
                      
                    </div>
                  </div>
                  <div class="newsletter_bot_paragraph">
                    {% render 'paragraph', tidy_text: paragraph_tidy_text, custom_class: 'u-margin-bottom-0 u-weight-primary-regular', paragraph: paragraph, variant: 'u-text-body-small', max_width: paragraph_max_width %}
                  </div>
                </div>
              </form>
              <div class="w-form-done">
                <div>Thank you! Your submission has been received!</div>
              </div>
              <div class="w-form-fail">
                <div>Oops! Something went wrong while submitting the form.</div>
              </div>
            </div>
          </div>
