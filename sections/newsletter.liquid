    position: absolute;
    inset: 0;
    background:;
  }
  .newsletter_layout[data-variant='large'] {
    padding-top: calc(var(--_spacing---space--14) * 2);
    padding-bottom: calc(var(--_spacing---space--14) * 2);
  }
  .newsletter_bot_paragraph a {
    font-weight: var(--_typography---font--primary-semibold);
  }
  .newsletter_bot_paragraph .u-text a {
    font-weight: var(--_typography---font--primary-semibold);
    text-decoration: underline;
  }
  @container (width < 42em) {
    .newsletter_button_wrap .button_wrap {
      width: 100%;
    }
  }
</style>
